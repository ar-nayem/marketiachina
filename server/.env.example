PORT=8080

# Gmail Sender Management (admin > Email & Gmail) — Google Cloud Console >
# APIs & Services > Credentials > OAuth client ID (Web application), with
# Gmail API enabled and the OAuth consent screen's publishing status set to
# "In production" (Testing mode issues refresh tokens that expire after 7
# days). Redirect URI must exactly match GOOGLE_OAUTH_REDIRECT_URI below.
# The actual sending Gmail account is connected/changed at runtime from the
# admin panel, not from an env var — these three only identify the OAuth app.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/admin/email/oauth/callback

# Encrypts stored Gmail refresh tokens at rest (AES-256-GCM). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing this after a Gmail has been connected invalidates its stored
# token — the admin would need to reconnect.
ENCRYPTION_KEY=

# Telegram order notifications — message @BotFather to create a bot and get
# its token, then message @userinfobot to get your own numeric chat id.
# Leave unset to skip Telegram notifications.
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather
TELEGRAM_CHAT_ID=123456789

# Pathao Merchant (courier) API — get client_id/client_secret by applying for
# API access via the Pathao merchant panel; username/password are your
# merchant login; store_id comes from your registered Pathao store. Use the
# sandbox base URL until verified end-to-end, then switch to production.
PATHAO_BASE_URL=https://courier-api-sandbox.pathao.com
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=
