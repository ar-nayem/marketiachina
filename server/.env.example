PORT=8080

# Gmail SMTP — Google Account > Security > 2-Step Verification > App Passwords
# (needs 2FA enabled on the Google account first). Order invoice emails are
# sent from this address. Leave unset to keep emails logged to mail_outbox
# only (admin > Outbox), without actually sending.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your16charapppassword
MAIL_FROM_NAME=Marketia China

# Telegram order notifications — message @BotFather to create a bot and get
# its token, then message @userinfobot to get your own numeric chat id.
# Leave unset to skip Telegram notifications.
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather
TELEGRAM_CHAT_ID=123456789
